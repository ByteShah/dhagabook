# ---- Public (built into the website) ----
# Your live domain, no trailing slash. Used for canonical URLs, Open Graph tags and sitemap.xml.
VITE_SITE_URL=https://www.dhagabook.com
# Optional Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable.
VITE_GTM_ID=
# Optional: send the form to a different endpoint instead of /api/lead.
VITE_FORM_ENDPOINT=

# ---- Server only: used by /api/lead (server/lead.js). Set these in your host's environment too. ----
RESEND_API_KEY=
LEAD_TO=maitrik@codecrafters.in
LEAD_FROM=DhagaBook Website <maitrik@codecrafters.in>
